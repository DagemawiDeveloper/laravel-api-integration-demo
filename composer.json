{
  "name": "dagemawi-developer/relayhub",
  "description": "Laravel API and webhook integration reference package with signed webhooks, deterministic idempotency, queues, retries, observability, and tests.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/database": "^12.0",
    "illuminate/http": "^12.0",
    "illuminate/queue": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5.3"
  },
  "autoload": {
    "psr-4": {
      "Dagemawi\\RelayHub\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dagemawi\\RelayHub\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dagemawi\\RelayHub\\RelayHubServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "lint": "find src config routes database tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
